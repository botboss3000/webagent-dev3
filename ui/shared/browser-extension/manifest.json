{
  "manifest_version": 3,
  "name": "WebAgent Browser Extension",
  "version": "0.1.0",
  "description": "Lets your WebAgent agent work in its own Chrome window on the sites your organization allows, while you watch and can take over.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "host_permissions": ["https://dev.webagent.live/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://dev.webagent.live/*"],
      "js": ["link.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [],
  "action": { "default_title": "WebAgent Browser Extension", "default_popup": "popup.html" }
}
