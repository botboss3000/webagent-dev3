{
  "compress_idle_days": 30,
  "compression": {
    "algorithm": "zstd",
    "level": 3,
    "min_bytes": 256,
    "mode": "on_save",
    "skip_media_types": [
      "image/*",
      "video/*",
      "audio/*",
      "application/zip",
      "application/gzip",
      "application/x-7z-compressed",
      "application/x-rar-compressed",
      "application/zstd"
    ]
  },
  "tiers": {
    "anonymous": {
      "agent_storage_mb": 0,
      "max_published_agents": 0,
      "user_storage_mb": 100
    },
    "basic": {
      "agent_storage_mb": 256,
      "max_published_agents": 5,
      "user_storage_mb": 1024
    },
    "operator": {
      "agent_storage_mb": null,
      "max_published_agents": null,
      "user_storage_mb": null
    }
  },
  "warning_percent": 80
}
