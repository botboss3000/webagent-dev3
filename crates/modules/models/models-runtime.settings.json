      "type": "integer",
      "pointer": "/streaming/response_start_seconds",
      "layers": [
        "app"
      ],
      "examples": [
        "allow slower first responses",
        "fail faster when a provider does not answer"
      ],
      "areas": [
        "models",
        "reliability"
      ],
      "unit": "seconds",
      "min": 5,
      "max": 600,
      "bounds": "validator"
    },
    {
