{
  "_instructions": "Setting descriptors for the configuration composer (see crates/modules/configuration/settings-catalog.json). Current values are always read live; descriptors hold no defaults.",
  "settings": [
    {
      "id": "models.retry.same_model_retries",
      "description": "How many times a model call that failed with a temporary provider error is retried on the same model before switching to a backup or stopping.",
      "type": "integer",
      "pointer": "/retry/same_model_retries",
      "layers": [
        "app"
      ],
      "examples": [
        "retry overloaded providers more times",
        "give up sooner when a provider is down"
      ],
      "areas": [
        "models",
        "reliability"
      ],
      "unit": "retries",
      "min": 0,
      "max": 5,
      "bounds": "validator"
    },
    {
      "id": "models.retry.delays_seconds",
      "description": "Wait before each same-model retry; the last value repeats for further retries.",
      "type": "integer",
      "pointer": "/retry/delays_seconds/{step}",
      "layers": [
        "app"
      ],
      "examples": [
        "wait longer between retries",
        "retry after 5 seconds first"
      ],
      "areas": [
        "models",
        "reliability"
      ],
      "parameters": {
        "step": [
          "0",
          "1"
        ]
      },
      "unit": "seconds",
      "min": 0,
      "max": 300,
      "bounds": "validator"
    },
    {
      "id": "models.retry.jitter_percent",
      "description": "Random extra share added to each retry wait so many runs do not retry at the same moment.",
      "type": "integer",
      "pointer": "/retry/jitter_percent",
      "layers": [
        "app"
      ],
      "examples": [
        "spread out retries more",
        "no random retry delay"
      ],
      "areas": [
        "models",
        "reliability"
      ],
      "unit": "percent",
      "min": 0,
      "max": 100,
      "bounds": "validator"
    },
    {
      "id": "models.retry.max_retry_after_seconds",
      "description": "Longest wait honored when a provider asks to retry later.",
      "type": "integer",
      "pointer": "/retry/max_retry_after_seconds",
      "layers": [
        "app"
      ],
      "examples": [
        "honor provider retry hints up to two minutes"
      ],
      "areas": [
        "models",
        "reliability"
      ],
      "unit": "seconds",
      "min": 0,
      "max": 600,
      "bounds": "validator"
    },
    {
      "id": "models.retry.auto_resume_after_seconds",
      "description": "After retries run out on a run that is safe to resume, how long to wait before resuming it automatically.",
      "type": "integer",
      "pointer": "/retry/auto_resume_after_seconds",
      "layers": [
        "app"
      ],
      "examples": [
        "auto resume stopped runs after 5 minutes",
        "resume sooner after an outage"
      ],
      "areas": [
        "models",
        "reliability"
      ],
      "unit": "seconds",
      "min": 10,
      "max": 3600,
      "bounds": "validator"
    },
    {
      "id": "models.retry.auto_resume_attempts",
      "description": "How many times a stopped run is resumed automatically before waiting for the user.",
      "type": "integer",
      "pointer": "/retry/auto_resume_attempts",
      "layers": [
        "app"
      ],
      "examples": [
        "never auto resume",
        "auto resume twice"
      ],
      "areas": [
        "models",
        "reliability"
      ],
      "unit": "attempts",
      "min": 0,
      "max": 3,
      "bounds": "validator"
    },
    {
