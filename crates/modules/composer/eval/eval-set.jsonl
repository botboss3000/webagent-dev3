{"id": "E116", "category": "near_miss", "role": "visitor", "agent": null, "page": "user", "request": "Make the floating chat window wider", "expect": {"outcome": "other_page", "setting": "chat.widget.window.width", "note": "widget, not the docked chat panel"}}
