{"id": "H001", "category": "paraphrase", "role": "visitor", "agent": null, "page": "user", "request": "The conversation pane hogs too much of my screen", "expect": {"setting": "app_ui.chat_panel.width", "layer": "user", "change": {"op": "decrease"}}}
{"id": "H002", "category": "direct", "role": "admin", "agent": null, "page": "app", "request": "Chat column 35 percent wide by default", "expect": {"setting": "app_ui.chat_panel.width", "layer": "app", "value": {"width": 35, "unit": "%"}}}
{"id": "H003", "category": "paraphrase", "role": "visitor", "agent": null, "page": "user", "request": "Let the chat fill my whole phone display, right up to the top", "expect": {"setting": "app_ui.mobile_mode.full_height", "layer": "user", "value": true}}
{"id": "H004", "category": "paraphrase", "role": "visitor", "agent": null, "page": "user", "request": "Refreshing kicks in when I'm just scrolling, make that area tiny", "expect": {"setting": "app_ui.pull_to_refresh.start_zone_px", "layer": "user", "change": {"op": "decrease"}}}
{"id": "H005", "category": "relative", "role": "visitor", "agent": null, "page": "user", "request": "Bump the message lettering up by 3", "expect": {"setting": "chat.message_bubbles.font_size_px", "layer": "user", "change": {"op": "add", "by": 3}}}
{"id": "H006", "category": "paraphrase", "role": "visitor", "agent": null, "page": "user", "request": "I can barely see the words in my messages", "expect": {"setting": "chat.message_bubbles.font_size_px", "layer": "user", "change": {"op": "increase"}}}
{"id": "H007", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Fresh conversations should begin by asking before acting", "expect": {"setting": "chat.execution_mode.default_mode", "layer": "app", "value": "ask"}}
{"id": "H008", "category": "paraphrase", "role": "operator", "agent": "research", "page": "agent:research", "request": "My assistant should draft a plan first in every new conversation", "expect": {"setting": "chat.execution_mode.default_mode", "layer": "agent", "value": "plan"}}
{"id": "H009", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Pop up a confirmation whenever someone flips on auto", "expect": {"setting": "chat.execution_mode.confirm_auto_mode", "layer": "app", "value": true}}
{"id": "H010", "category": "direct", "role": "admin", "agent": null, "page": "app", "request": "Uploads capped at 75 MB", "expect": {"setting": "chat.limits.attachments.max_file_size_mb", "layer": "app", "value": 75}}
{"id": "H011", "category": "out_of_range", "role": "admin", "agent": null, "page": "app", "request": "Permit 500 MB uploads", "expect": {"outcome": "out_of_range", "setting": "chat.limits.attachments.max_file_size_mb"}}
{"id": "H012", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Folks may attach up to a dozen files to one message", "expect": {"setting": "chat.limits.attachments.max_per_message", "layer": "app", "value": 12}}
{"id": "H013", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Look for new replies every 3 seconds", "expect": {"setting": "chat.live_reload.interval_ms", "layer": "app", "value": 3000}}
{"id": "H014", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "The empty message field should read 'What do you need?'", "expect": {"setting": "chat.composer.placeholder", "layer": "app", "value": "What do you need?"}}
{"id": "H015", "category": "paraphrase", "role": "visitor", "agent": null, "page": "user", "request": "Opening a conversation should clear its unread dot", "expect": {"setting": "chat.mark_read_on_visit", "layer": "user", "value": true}}
{"id": "H016", "category": "paraphrase", "role": "visitor", "agent": null, "page": "user", "request": "I don't want the notes strip at all", "expect": {"setting": "chat.main_notes.enabled", "layer": "user", "value": false}}
{"id": "H017", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Phones should preload 60 earlier messages", "expect": {"setting": "chat.mobile.transcript_window.messages_above", "layer": "app", "value": 60}}
{"id": "H018", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "The embedded chat popup should be 600 px across", "expect": {"setting": "chat.widget.window.width", "layer": "app", "value": 600}}
{"id": "H019", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Dock the floating chat button on the left", "expect": {"setting": "chat.widget.launcher.position", "layer": "app", "value": "left"}}
{"id": "H020", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Shut the door on new accounts", "expect": {"setting": "access.registration", "layer": "app", "value": "restricted"}}
{"id": "H021", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Allow 8 bad password tries before locking an account", "expect": {"setting": "access.login_protection.account.failures", "layer": "app", "value": 8}}
{"id": "H022", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Ban misbehaving IPs for 10 minutes", "expect": {"setting": "access.login_protection.address.block_seconds", "layer": "app", "value": 600}}
{"id": "H023", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Basic members can hold 40 conversations", "expect": {"setting": "access.tier.max_sessions", "layer": "app", "value": 40, "params": {"tier": "basic"}}}
{"id": "H024", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Guests who aren't logged in may run 2 jobs simultaneously", "expect": {"setting": "access.tier.max_active_runs", "layer": "app", "value": 2, "params": {"tier": "anonymous"}}}
{"id": "H025", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Relabel the operator level as Staff", "expect": {"setting": "access.tier_names", "layer": "app", "value": "Staff", "params": {"tier": "operator"}}}
{"id": "H026", "category": "paraphrase", "role": "operator", "agent": "research", "page": "agent:research", "request": "Hold off on condensing the history until 200k tokens", "expect": {"setting": "context.compaction.trigger_tokens", "layer": "agent", "value": 200000}}
{"id": "H027", "category": "paraphrase", "role": "operator", "agent": "research", "page": "agent:research", "request": "After condensing, keep the last 25k tokens word for word", "expect": {"setting": "context.compaction.tail_tokens", "layer": "agent", "value": 25000}}
{"id": "H028", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Run up to 12 agent jobs on the box at the same time", "expect": {"setting": "loop.scheduler.max_active_runs", "layer": "app", "value": 12}}
{"id": "H029", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Tools may fire 3 calls side by side", "expect": {"setting": "loop.tools.max_parallel_calls", "layer": "app", "value": 3}}
{"id": "H030", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Spoken input can go on for 15 minutes", "expect": {"setting": "media.dictation.max_recording_seconds", "layer": "app", "value": 900}}
{"id": "H031", "category": "paraphrase", "role": "admin", "agent": null, "page": "app", "request": "Free the speech engine from memory after 20 idle minutes", "expect": {"setting": "media.speech.idle_unload_minutes", "layer": "app", "value": 20}}
{"id": "H032", "category": "paraphrase", "role": "operator", "agent": "research", "page": "agent:research", "request": "Stop my agent talking out loud", "expect": {"setting": "agent.voice_output", "layer": "agent", "value": {"enabled": false}}}
{"id": "H033", "category": "paraphrase", "role": "operator", "agent": "research", "page": "agent:research", "request": "Nobody should be able to pass around chats with my agent", "expect": {"setting": "agent.shared_chat.shareable", "layer": "agent", "value": false}}
{"id": "H034", "category": "paraphrase", "role": "operator", "agent": "research", "page": "agent:research", "request": "Only signed-in people may talk to my agent", "expect": {"setting": "agent.member_access.visitor_access", "layer": "agent", "value": false}}
{"id": "H035", "category": "paraphrase", "role": "operator", "agent": "research", "page": "agent:research", "request": "Show the steps my agent takes while it works", "expect": {"setting": "agent.message_visibility.mode", "layer": "agent", "value": "auto"}}
{"id": "H036", "category": "paraphrase", "role": "visitor", "agent": null, "page": "user", "request": "Address me as Jordan", "expect": {"setting": "user.display_name", "layer": "user", "value": "Jordan"}}
{"id": "H037", "category": "permission", "role": "visitor", "agent": null, "page": "user", "request": "Stop strangers from registering", "expect": {"outcome": "other_page", "setting": "access.registration"}}
{"id": "H038", "category": "permission", "role": "operator", "agent": "research", "page": "agent:research", "request": "Raise the whole server's concurrency to 20", "expect": {"outcome": "other_page", "setting": "loop.scheduler.max_active_runs"}}
{"id": "H039", "category": "no_match", "role": "visitor", "agent": null, "page": "user", "request": "Translate this paragraph into French", "expect": {"outcome": "no_match"}}
{"id": "H040", "category": "no_match", "role": "admin", "agent": null, "page": "app", "request": "Rotate the database encryption key", "expect": {"outcome": "no_match", "note": "credentials are excluded"}}
