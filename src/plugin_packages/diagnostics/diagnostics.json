{
  "version": 1,
  "enabled": true,
  "capture_scope": "fixed_admin",
  "categories": {
    "provider": true,
    "context_assembly": true
  },
  "assembly_successes": true,
  "retention": {
    "hours": 168,
    "max_rows": 200000
