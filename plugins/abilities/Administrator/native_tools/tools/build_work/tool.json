{
  "name": "build_work",
  "description": "Manage isolated broker work. Broker ID selects one independently deployable outcome: begin new work with a label and summary, omit to continue it, or reuse a returned ID. Broker Job ID identifies execution; Broker Release ID identifies publication. Session identity and request receipts are runtime owned. Ownership and publication gates remain enforced.",
  "effect": "write",
  "policy_ceiling": "ask",
  "default_access": {
    "operator": "auto",
    "member": "deny",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "status",
          "begin",
          "finish",
          "abandon",
          "preflight",
          "decide",
          "review",
          "check",
          "receipt",
          "create",
          "reservations",
          "reserve",
          "heartbeat",
          "continue",
          "acceptance",
          "complete",
          "handoff",
          "takeover_preview",
          "takeover",
          "recover",
          "resources",
          "pause",
          "resume",
          "priority",
          "reconcile",
          "wait",
          "cancel"
        ]
      },
      "task_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,80}$",
        "description": "Deprecated compatibility alias for broker_id. Do not supply both."
      },
      "label": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{6,58}[a-z0-9]$",
        "description": "Required with begin: the new task's name and Broker ID, a lowercase hyphenated slug naming the outcome (e.g. abilities-chart-refresh). Unique; pick another if refused."
      },
      "summary": {
        "type": "string",
        "maxLength": 200,
        "description": "Required with begin: one plain sentence describing the outcome, shown in full on the Broker card. No chat or session IDs; the runtime attaches them."
      },
      "expected_inputs_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "sync_decision": {
        "type": "string",
        "enum": [
          "synchronize",
          "proceed",
          "cancel"
        ]
      },
      "expected_sync_digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "job_id": {
        "type": "string",
        "description": "Broker Job ID. status inspects it; wait follows it again after an early still_running result (returning at the next alert or its end); cancel stops it and keeps the task for a fix."
      },
      "request_id": {
        "type": "string"
      },
      "check": {
        "type": "string",
        "enum": [
          "check",
          "test",
          "fmt",
          "clippy",
          "ui_test"
        ]
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600
      },
      "feature_profile": {
        "type": "string",
        "enum": [
          "default",
          "live"
        ],
        "description": "check=check only: default compiles the linked build; live compiles the live host without linked implementation crates."
      },
      "test_filter": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_:]{1,160}$",
        "description": "check=test only: run just the tests whose names contain this text, such as a module path or test name."
      },
      "paths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "string",
          "maxLength": 240
        }
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0
      },
      "expected_epoch": {
        "type": "integer",
        "minimum": 1
      },
      "phase_id": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "priority": {
        "type": "integer",
        "minimum": -2,
        "maximum": 2
      },
      "target_task_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,80}$"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "commit": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "acceptance": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "check": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "passed": {
              "type": "boolean",
              "enum": [
                true
              ]
            }
          },
          "required": [
            "check",
            "passed"
          ],
          "additionalProperties": false
        }
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "task_key": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "broker_id": {
        "type": "string",
        "pattern": "^(new|[A-Za-z0-9_-]{8,80})$",
        "description": "Omit to continue current broker work; new with begin (label and summary required) creates independent work; a returned Broker ID selects existing work. Runtime attaches chat identity. Never invent an ID."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "build and deploy my code change",
      "run the checks on my source edits",
      "release the change to the dev app",
      "check the build status",
      "is my build done"
    ],
    "keywords": [
      "build",
      "deploy",
      "release",
      "broker",
      "build status",
      "check the build"
    ]
  }
}
