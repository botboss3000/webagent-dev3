{
  "name": "terminal_wait",
  "description": "Wait for bounded PTY output",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "ask",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "terminal_id": {
        "type": "string"
      },
      "cursor": {
        "type": "integer",
        "minimum": 0
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      }
    },
    "required": [
      "terminal_id"
    ],
    "additionalProperties": false
  }
}
