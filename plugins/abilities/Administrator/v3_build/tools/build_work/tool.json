{
  "name": "build_work",
  "description": "Manage isolated broker work. Broker ID selects one independently deployable outcome; omit to continue, new to separate, or reuse a returned ID. Broker Job ID identifies execution; Broker Release ID identifies publication. Session identity and request receipts are runtime owned. Ownership and publication gates remain enforced.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "deny",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "status",
          "begin",
          "finish",
          "abandon",
          "preflight",
          "decide",
          "review",
          "check",
          "receipt",
          "create",
          "reservations",
          "reserve",
          "heartbeat",
          "continue",
          "acceptance",
          "complete",
          "handoff",
          "takeover_preview",
          "takeover",
          "recover",
          "resources",
          "pause",
          "resume",
          "priority",
          "reconcile"
        ]
      },
      "task_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,80}$",
        "description": "Deprecated compatibility alias for broker_id. Do not supply both."
      },
      "summary": {
        "type": "string",
        "maxLength": 200
      },
      "expected_inputs_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "sync_decision": {
        "type": "string",
        "enum": [
          "synchronize",
          "proceed",
          "cancel"
        ]
      },
      "expected_sync_digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "job_id": {
        "type": "string"
      },
      "request_id": {
        "type": "string"
      },
      "check": {
        "type": "string",
        "enum": [
          "check",
          "test"
        ]
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600
      },
      "paths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "string",
          "maxLength": 240
        }
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0
      },
      "expected_epoch": {
        "type": "integer",
        "minimum": 1
      },
      "phase_id": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "priority": {
        "type": "integer",
        "minimum": -2,
        "maximum": 2
      },
      "target_task_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,80}$"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "commit": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "acceptance": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "check": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "passed": {
              "type": "boolean",
              "enum": [
                true
              ]
            }
          },
          "required": [
            "check",
            "passed"
          ],
          "additionalProperties": false
        }
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "task_key": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "broker_id": {
        "type": "string",
        "pattern": "^(new|[A-Za-z0-9_-]{8,80})$",
        "description": "Omit to continue current broker work; new creates independent work; a returned Broker ID selects existing work. Runtime attaches chat identity. Never invent an ID."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  }
}
