{
  "name": "v3_source_list",
  "description": "List immediate files and directories in an open isolated V3 task source snapshot; omit path to list the V3 root",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "ask",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,80}$"
      },
      "path": {
        "type": "string",
        "description": "V3-relative directory path, such as ui/main-panel; omit for the source root",
        "maxLength": 240
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "task_id"
    ],
    "additionalProperties": false
  }
}
