{
  "name": "v3_source_prepare",
  "description": "Generate and review an exact Git diff for one to eight new files in an open isolated V3 task. Returns a prepared_id to pass to v3_source_apply without copying patch text.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "deny",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{8,80}$"
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "New V3-relative source file path such as ui/main-panel/session-metrics/page.json",
              "maxLength": 240
            },
            "content": {
              "type": "string",
              "description": "Complete UTF-8 file text, ending with a newline",
              "maxLength": 16000
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      },
      "expected_inputs_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "task_id",
      "files",
      "expected_inputs_sha256"
    ],
    "additionalProperties": false
  }
}
