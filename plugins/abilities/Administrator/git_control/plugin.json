{
  "version": 1,
  "id": "git_control",
  "protocol": 1,
  "runtime": "python3",
  "entrypoint": "transport.py",
  "interface": 1,
  "tools": [
    "repository_access",
    "git_tool",
    "resolve_conflict",
    "commit_and_push",
    "source_remote_read",
    "source_remote_commit",
    "source_site_create",
    "source_site_status",
    "source_preview_start",
    "source_preview_stop",
    "source_publish",
    "source_rollback"
  ],
  "build": {
    "inputs": [
      "adapter.py",
      "transport.py",
      "file_manager.py",
      "askpass.py"
    ],
    "dependencies": [],
    "toolchain": "image-python3",
    "flags": [
      "-I",
      "-B"
    ],
    "assets": [
      "git_control.json",
      "git_control.skill.md",
      "tools"
    ]
  }
}
