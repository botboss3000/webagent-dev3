{
  "name": "source_preview_start",
  "description": "Request a remote Cloudflare build for an exact GitHub draft commit. Return its receipt; inspect status until ready.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "deny",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "site_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "connection_revision": {
        "type": "integer",
        "minimum": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "branch": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "commit_sha": {
        "type": "string",
        "minLength": 40,
        "maxLength": 40
      }
    },
    "required": [
      "site_id",
      "connection_revision",
      "request_id",
      "branch",
      "commit_sha"
    ],
    "additionalProperties": false
  }
}
