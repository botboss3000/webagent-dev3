{
  "name": "git_tool",
  "description": "Typed Git operations in a workspace repository, or administrator inspection and push of the published V3 checkout with repo=__root__; mutations need approval and an exact HEAD fence",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "deny",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "status",
          "diff",
          "log",
          "show",
          "branch_list",
          "branch_create",
          "branch_delete",
          "tag_list",
          "tag_create",
          "tag_delete",
          "checkout",
          "stash_list",
          "stash_push",
          "stash_pop",
          "add",
          "reset",
          "pull",
          "push"
        ]
      },
      "repo": {
        "type": "string"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 100
      },
      "ref": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "remote": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "cached": {
        "type": "boolean"
      },
      "expected_head": {
        "type": "string"
      }
    },
    "required": [
      "operation"
    ],
    "additionalProperties": false
  }
}
