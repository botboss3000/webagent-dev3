{
  "name": "code_index_coverage",
  "description": "code index coverage in this session isolated source snapshot; freshness is explicit",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "ask",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "root": {
        "type": "string",
        "maxLength": 512
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5000
      },
      "action": {
        "type": "string",
        "enum": [
          "gaps",
          "report",
          "stale"
        ]
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
