{
  "name": "code_index_scan",
  "description": "code index scan in this session isolated source snapshot; freshness is explicit",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "deny",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "root": {
        "type": "string",
        "maxLength": 512
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5000
      },
      "scope": {
        "type": "string",
        "maxLength": 512
      },
      "file_path": {
        "type": "string",
        "maxLength": 512
      },
      "batch_id": {
        "type": "string",
        "maxLength": 80
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0
      },
      "action": {
        "type": "string",
        "enum": [
          "discover",
          "scan",
          "scan_file"
        ]
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  }
}
