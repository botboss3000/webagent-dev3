    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "name": {
        "maxLength": 255,
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  }
}
