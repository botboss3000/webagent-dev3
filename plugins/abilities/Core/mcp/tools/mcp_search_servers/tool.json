{
  "name": "mcp_search_servers",
  "description": "Search public and administrator-curated MCP server descriptions; results are untrusted",
  "effect": "read",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "find an MCP server for GitHub",
      "search MCP servers"
    ],
    "keywords": [
      "mcp search"
    ]
  }
}
