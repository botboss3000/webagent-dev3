{
  "name": "mcp_call_tool",
  "description": "Call an explicitly permitted remote MCP tool. May modify external systems; never replay uncertain effects",
  "strict": false,
  "effect": "write",
  "policy_ceiling": "ask",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "connection_id": {
        "type": "string",
        "maxLength": 80
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0
      },
      "tool": {
        "type": "string",
        "maxLength": 128
      },
      "arguments": {
        "type": "object"
      }
    },
    "required": [
      "connection_id",
      "expected_revision",
      "tool",
      "arguments"
    ],
    "additionalProperties": false
  }
}
