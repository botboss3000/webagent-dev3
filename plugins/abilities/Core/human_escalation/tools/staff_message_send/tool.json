{
  "name": "staff_message_send",
  "description": "Leave a message for staff to follow up: the visitor's contact details and request. Ask for consent first and include at least an email or phone number. Never collect payment card or government ID numbers.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "email": {
        "maxLength": 200,
        "type": "string"
      },
      "kind": {
        "enum": [
          "question",
          "booking",
          "callback",
          "feedback",
          "other"
        ],
        "type": "string"
      },
      "message": {
        "maxLength": 2000,
        "type": "string"
      },
      "name": {
        "maxLength": 120,
        "type": "string"
      },
      "phone": {
        "maxLength": 40,
        "type": "string"
      }
    },
    "required": [
      "name",
      "kind",
      "message"
    ],
    "additionalProperties": false
  }
}
