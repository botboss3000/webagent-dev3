{
  "name": "staff_message_list",
  "description": "Staff only. List the newest visitor messages, optionally filtered by status.",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "limit": {
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "status": {
        "enum": [
          "new",
          "contacted",
          "resolved",
          "closed"
        ],
        "type": "string"
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
