{
  "name": "edit_genui",
  "description": "Edit one private mini app using its exact revision. Supply replacement html or exactly one old_text/new_text replacement. Displays the updated app in this conversation.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "expected_revision": {
        "minimum": 1,
        "type": "integer"
      },
      "genui_id": {
        "format": "uuid",
        "type": "string"
      },
      "html": {
        "maxLength": 32768,
        "type": "string"
      },
      "new_text": {
        "maxLength": 32768,
        "type": "string"
      },
      "old_text": {
        "maxLength": 32768,
        "type": "string"
      }
    },
    "required": [
      "genui_id",
      "expected_revision"
    ],
    "additionalProperties": false
  }
}
