{
  "name": "generate_image",
  "description": "Generate one image using this agent's assigned Image Out role. Returns an authenticated image URL. Interrupted requests are not silently repeated.",
  "effect": "write",
  "policy_ceiling": "ask",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "prompt": {
        "maxLength": 16384,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "prompt"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "generate an image",
      "draw a picture of a cat",
      "create a logo"
    ],
    "keywords": [
      "image",
      "draw",
      "picture"
    ]
  }
}
