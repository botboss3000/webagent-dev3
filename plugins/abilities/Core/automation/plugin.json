{
  "id": "automation",
  "dispatch": "isolated",
  "host_interface": "automation_v1",
  "protocol": 1,
  "interface": 1,
  "runtime": "executable",
  "entrypoint": "webagent_automation",
  "effect": "write",
  "tools": [
    "list_event_sources",
    "list_delivery_channels",
    "event_subscribe",
    "list_event_subscriptions",
    "event_unsubscribe",
    "schedule_task",
    "remind_me",
    "list_automations",
    "update_automation",
    "pause_automation",
    "resume_automation",
    "cancel_automation",
    "run_automation_now",
    "remember_automation_state"
  ],
  "build": {
    "toolchain": "rust-1.99",
    "inputs": [
      "Cargo.toml",
      "Cargo.lock",
      "service/main.rs",
      "service/engine.rs",
      "service/contracts.rs"
    ],
    "dependencies": [],
    "flags": [],
    "assets": [
      "automation.json",
      "automation.skill.md",
      "service/package.json",
      "service/page.json",
      "service/page.js",
      "service/page.css",
      "tools/list_event_sources/tool.json",
      "tools/list_delivery_channels/tool.json",
      "tools/event_subscribe/tool.json",
      "tools/list_event_subscriptions/tool.json",
      "tools/event_unsubscribe/tool.json",
      "tools/schedule_task/tool.json",
      "tools/remind_me/tool.json",
      "tools/list_automations/tool.json",
      "tools/update_automation/tool.json",
      "tools/pause_automation/tool.json",
      "tools/resume_automation/tool.json",
      "tools/cancel_automation/tool.json",
      "tools/run_automation_now/tool.json",
      "tools/remember_automation_state/tool.json"
    ]
  }
}
