{
  "name": "remember_automation_state",
  "description": "remember automation state through the optional Automation service. Changes use revision checks; external adapters are unavailable.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      },
      "occurrence_id": {
        "type": "string"
      },
      "memory": {}
    },
    "required": [
      "id",
      "expected_revision",
      "occurrence_id",
      "memory"
    ],
    "additionalProperties": false
  }
}
