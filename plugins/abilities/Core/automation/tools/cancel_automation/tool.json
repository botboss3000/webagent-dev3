{
  "name": "cancel_automation",
  "description": "cancel automation through the optional Automation service. Changes use revision checks; external adapters are unavailable.",
  "effect": "write",
  "policy_ceiling": "ask",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "id",
      "expected_revision"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "delete an automation",
      "cancel a scheduled task"
    ],
    "keywords": [
      "cancel automation"
    ]
  }
}
