{
  "name": "edit_source",
  "description": "Replace exactly one frontend text span in isolated UI work; requires the current task digest.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "broker_id": {
        "maxLength": 80,
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "expected_inputs_sha256": {
        "maxLength": 64,
        "type": "string"
      },
      "limit": {
        "maximum": 200,
        "minimum": 1,
        "type": "integer"
      },
      "new_text": {
        "type": "string"
      },
      "offset": {
        "minimum": 1,
        "type": "integer"
      },
      "old_text": {
        "type": "string"
      },
      "patch": {
        "type": "string"
      },
      "path": {
        "maxLength": 240,
        "type": "string"
      },
      "query": {
        "maxLength": 1000,
        "type": "string"
      }
    },
    "required": [
      "path",
      "old_text",
      "new_text",
      "expected_inputs_sha256"
    ],
    "additionalProperties": false
  }
}
