{
  "name": "search_source",
  "description": "Search UI source by literal text in the selected isolated work; no backend paths.",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "broker_id": {
        "maxLength": 80,
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "expected_inputs_sha256": {
        "maxLength": 64,
        "type": "string"
      },
      "limit": {
        "maximum": 200,
        "minimum": 1,
        "type": "integer"
      },
      "new_text": {
        "type": "string"
      },
      "offset": {
        "minimum": 1,
        "type": "integer"
      },
      "old_text": {
        "type": "string"
      },
      "patch": {
        "type": "string"
      },
      "path": {
        "maxLength": 240,
        "type": "string"
      },
      "query": {
        "maxLength": 1000,
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  }
}
