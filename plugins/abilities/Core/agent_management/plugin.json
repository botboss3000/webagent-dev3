{
  "id": "agent_management",
  "dispatch": "isolated",
  "host_interface": "requests_v1",
  "protocol": 2,
  "interface": 1,
  "runtime": "executable",
  "entrypoint": "webagent_agent_management",
  "effect": "write",
  "tools": [
    "list_agent_templates",
    "list_my_agents",
    "get_agent",
    "list_agent_tools",
    "create_agent",
    "update_agent",
    "set_agent_tool",
    "edit_agent_prompt",
    "set_agent_ability",
    "manage_agent_skills",
    "manage_agent_chat_config",
    "list_user_sessions",
    "manage_user_session",
    "watch_sessions",
    "create_user_session"
  ],
  "requests": [
    "agents.list",
    "agents.identity.read",
    "agents.abilities.read",
    "agents.create",
    "agents.identity.update",
    "agents.tool_mode.set",
    "agents.ability_visibility.set",
    "agents.slot.write",
    "agents.chat_config.read",
    "agents.chat_config.patch",
    "agents.chat_config.reset",
    "skills.list",
    "skills.read",
    "skills.save",
    "skills.remove",
    "sessions.list",
    "sessions.create",
    "sessions.read",
    "sessions.update",
    "sessions.recycle",
    "sessions.restore",
    "sessions.watch",
    "ability.settings"
  ],
  "build": {
    "toolchain": "rust-1.99",
    "inputs": [
      "Cargo.toml",
      "Cargo.lock",
      "plugin/lib.rs",
      "plugin/main.rs"
    ],
    "dependencies": [],
    "flags": [],
    "assets": [
      "agent_management.json",
      "agent_management.skill.md",
      "tools/create_agent/tool.json",
      "tools/create_user_session/tool.json",
      "tools/edit_agent_prompt/tool.json",
      "tools/get_agent/tool.json",
      "tools/kick_user_session/tool.json",
      "tools/list_agent_templates/tool.json",
      "tools/list_agent_tools/tool.json",
      "tools/list_my_agents/tool.json",
      "tools/list_user_sessions/tool.json",
      "tools/manage_agent_chat_config/tool.json",
      "tools/manage_agent_skills/tool.json",
      "tools/manage_user_session/tool.json",
      "tools/set_agent_ability/tool.json",
      "tools/set_agent_tool/tool.json",
      "tools/update_agent/tool.json",
      "tools/watch_sessions/tool.json"
    ]
  }
}
