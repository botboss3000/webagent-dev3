{
  "name": "message_session",
  "description": "Send an attributed message to a session in scope. steer (default) delivers at its next turn boundary, queue after its current run, interrupt stops the current run. Returns admission, not the reply.",
  "effect": "write",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string",
        "format": "uuid"
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      },
      "delivery": {
        "type": "string",
        "enum": [
          "steer",
          "queue",
          "interrupt"
        ]
      }
    },
    "required": [
      "session_id",
      "text"
    ],
    "additionalProperties": false
  }
}
