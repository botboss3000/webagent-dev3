{
  "name": "manage_user_session",
  "description": "Rename, pin, archive or unarchive a caller-owned session. Request: expected_revision plus title/pinned for update. Archiving is reversible.",
  "effect": "write",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "ask"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "enum": [
          "update",
          "archive",
          "unarchive"
        ],
        "type": "string"
      },
      "request": {
        "type": "object"
      },
      "session_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "action",
      "request"
    ],
    "additionalProperties": false
  }
}
