{
  "name": "wiki_create",
  "description": "App administrators only. Create a Wiki article; its slug is derived from the title. Search first to avoid duplicates. New articles are drafts (members only) unless status is published.",
  "effect": "write",
  "default_access": {
    "operator": "auto"
  },
  "account_access": {
    "operator": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 200
      },
      "body": {
        "type": "string",
        "description": "Markdown. Link articles with [[Title]] or [[slug]]."
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 40
        },
        "maxItems": 20
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 60
        },
        "maxItems": 30,
        "description": "Synonyms, related terms and questions this article answers, so searches with other wording find it."
      },
      "category": {
        "type": "string",
        "maxLength": 60
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "published"
        ]
      }
    },
    "required": [
      "title",
      "body"
    ],
    "additionalProperties": false
  }
}
