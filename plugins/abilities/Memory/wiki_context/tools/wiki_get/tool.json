{
  "name": "wiki_get",
  "description": "Read one full Wiki article by slug, including its current revision.",
  "effect": "read",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "account_access": {
    "operator": "auto",
    "basic": "auto",
    "anonymous": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "maxLength": 80,
        "description": "Article slug from wiki_search or wiki_list."
      }
    },
    "required": [
      "slug"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "read a wiki article",
      "open the wiki page on deployment"
    ],
    "keywords": [
      "wiki page"
    ]
  }
}
