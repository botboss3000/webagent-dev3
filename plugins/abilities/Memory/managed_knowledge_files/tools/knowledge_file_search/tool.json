{
  "name": "knowledge_file_search",
  "description": "Search this agent's knowledge files by words and return the best-matching files with short excerpts. Use before answering questions about the business.",
  "effect": "read",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "limit": {
        "maximum": 10,
        "minimum": 1,
        "type": "integer"
      },
      "query": {
        "maxLength": 200,
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "search the knowledge base",
      "look up our opening hours in the docs"
    ],
    "keywords": [
      "knowledge",
      "faq"
    ]
  }
}
