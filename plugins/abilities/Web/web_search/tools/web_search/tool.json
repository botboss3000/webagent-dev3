{
  "name": "web_search",
  "description": "Search the web through this agent's enabled providers (Tavily, Brave Search, Wikipedia, DuckDuckGo) in its configured order; returns titles, URLs and snippets",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "provider": {
        "type": "string",
        "enum": [
          "tavily",
          "brave",
          "wikipedia",
          "duckduckgo"
        ]
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  }
}
