{
  "name": "web_search",
  "description": "Search public web results via DuckDuckGo; provider challenges are errors, not empty results",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "max_results": {
        "maximum": 10,
        "minimum": 1,
        "type": "integer"
      },
      "query": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  }
}
