{
  "name": "get_weather",
  "description": "Current Open-Meteo weather by city or lat,lon; no API key required",
  "effect": "read",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "location": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "units": {
        "enum": [
          "metric",
          "imperial"
        ],
        "type": "string"
      }
    },
    "required": [
      "location"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "what is the weather in Berlin",
      "will it rain tomorrow"
    ],
    "keywords": [
      "weather",
      "forecast"
    ]
  }
}
