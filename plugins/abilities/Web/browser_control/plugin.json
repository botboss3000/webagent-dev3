{
  "version": 1,
  "id": "browser_control",
  "protocol": 1,
  "interface": 1,
  "runtime": "python3",
  "entrypoint": "runner.py",
  "tools": [
    "browser_read",
    "browser_input",
    "browser_record"
  ],
  "build": {
    "inputs": [
      "runner.py",
      "adapter.py",
      "egress.py"
    ],
    "dependencies": [],
    "toolchain": "image-python3",
    "flags": [
      "-I",
      "-B"
    ],
    "assets": [
      "browser_control.json",
      "browser_control.skill.md",
      "tools"
    ]
  }
}
