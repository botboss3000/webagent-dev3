{
  "name": "browser_record",
  "description": "Record up to 30 screenshots over 30 seconds of the private server browser; frames attach to the reply",
  "effect": "read",
  "default_access": {
    "operator": "auto",
    "member": "ask",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "start",
          "stop",
          "status"
        ]
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  }
}
