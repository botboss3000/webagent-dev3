{
  "name": "browser_record",
  "description": "Record up to 30 screenshots over 30 seconds of the private server browser; frames attach to the reply",
  "effect": "read",
  "default_policy": {
    "operator": "allow",
    "member": "require_approval",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "start",
          "stop",
          "status"
        ]
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "record a short video of the page",
      "capture an animation"
    ],
    "keywords": [
      "record",
      "video"
    ]
  }
}
