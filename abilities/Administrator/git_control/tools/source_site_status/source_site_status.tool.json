{
  "name": "source_site_status",
  "description": "Inspect saved remote sites, exact build receipts and unresolved effects. With no site_id, lists your sites. No site source is stored locally.",
  "effect": "read",
  "retention": {
    "output": "disposable"
  },
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "site_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "connection_revision": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "list my websites",
      "what is the status of my site build"
    ],
    "keywords": [
      "site status",
      "build status"
    ]
  }
}
