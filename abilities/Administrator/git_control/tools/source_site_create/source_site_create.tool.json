{
  "name": "source_site_create",
  "description": "Configure a site connection, create a private GitHub repository and static Cloudflare Worker, or connect an existing static site.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "deny",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "site_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "connection_revision": {
        "type": "integer",
        "minimum": 0
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "operation": {
        "type": "string",
        "enum": [
          "create",
          "connect",
          "configure"
        ]
      },
      "configuration": {
        "type": "object",
        "properties": {
          "github_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "github_repo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "production_branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "cloudflare_account_id": {
            "type": "string",
            "maxLength": 32
          },
          "worker_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "build_token_uuid": {
            "type": "string",
            "maxLength": 36
          },
          "root_directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "build_command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "custom_domain": {
            "description": "Optional hostname in a Cloudflare zone of the same account, e.g. site.example.com",
            "type": "string",
            "maxLength": 253
          }
        },
        "required": [
          "github_owner",
          "github_repo",
          "worker_name"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "site_id",
      "connection_revision",
      "request_id",
      "operation"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "create a new website",
      "set up a site with GitHub and Cloudflare"
    ],
    "keywords": [
      "new site",
      "website"
    ]
  }
}
