{
  "id": "diagnostics",
  "dispatch": "isolated",
  "host_interface": "requests_v1",
  "protocol": 2,
  "interface": 1,
  "runtime": "executable",
  "entrypoint": "webagent_diagnostics",
  "effect": "write",
  "tools": [
    "read_diagnostics",
    "agent_review",
    "test_login"
  ],
  "requests": [
    "diagnostics.progress",
    "diagnostics.issues",
    "review.note",
    "review.open",
    "review.resolve",
    "testing.login"
  ],
  "build": {
    "toolchain": "rust-1.99",
    "inputs": [
      "Cargo.toml",
      "Cargo.lock",
      "plugin/lib.rs",
      "plugin/main.rs"
    ],
    "dependencies": [],
    "flags": [],
    "assets": [
      "diagnostics.json",
      "skills/diagnostics.skill.md",
      "skills/journey_testing.skill.md",
      "tools/read_diagnostics/read_diagnostics.tool.json",
      "tools/read_diagnostics/read_diagnostics.skill.md",
      "tools/agent_review/agent_review.tool.json",
      "tools/agent_review/agent_review.skill.md",
      "tools/test_login/test_login.tool.json",
      "tools/test_login/test_login.skill.md"
    ]
  }
}
