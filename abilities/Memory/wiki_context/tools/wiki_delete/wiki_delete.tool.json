{
  "name": "wiki_delete",
  "description": "App administrators only: remove a Wiki article for everyone (restorable).",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval"
  },
  "owner_tier": [
    "administrator"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "maxLength": 80,
        "description": "Article slug from wiki_search or wiki_list."
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0,
        "description": "The article's current revision from wiki_get."
      }
    },
    "required": [
      "slug",
      "expected_revision"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "delete a wiki article"
    ],
    "keywords": [
      "delete wiki"
    ]
  }
}
