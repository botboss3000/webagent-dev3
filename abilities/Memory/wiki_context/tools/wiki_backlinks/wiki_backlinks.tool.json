{
  "name": "wiki_backlinks",
  "description": "List the Wiki articles that link to this one with [[...]]. Check before renaming or deleting an article.",
  "effect": "read",
  "retention": {
    "output": "disposable"
  },
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "allow"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "maxLength": 80,
        "description": "Article slug from wiki_search or wiki_list."
      }
    },
    "required": [
      "slug"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "which wiki pages link here"
    ],
    "keywords": [
      "backlinks"
    ]
  }
}
