{
  "name": "wiki_list",
  "description": "List Wiki articles newest first (title, tags, category, status, snippet), optionally in one category. At most 100 are returned with the total count.",
  "effect": "read",
  "retention": {
    "output": "disposable"
  },
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "allow"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "maxLength": 60
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "list wiki articles",
      "what is in the wiki"
    ],
    "keywords": [
      "wiki"
    ]
  }
}
