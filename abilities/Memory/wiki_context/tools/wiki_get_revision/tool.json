{
  "name": "wiki_get_revision",
  "description": "Staff only. Read one saved version of an article without changing it.",
  "effect": "read",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "account_access": {
    "operator": "auto",
    "basic": "auto",
    "anonymous": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "revision_id": {
        "type": "string",
        "maxLength": 100,
        "description": "Revision ID from wiki_history."
      }
    },
    "required": [
      "revision_id"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "read an old version of a wiki page"
    ],
    "keywords": [
      "wiki revision"
    ]
  }
}
