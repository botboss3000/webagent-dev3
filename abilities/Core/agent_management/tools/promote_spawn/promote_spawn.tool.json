{
  "name": "promote_spawn",
  "description": "Create a reusable caller-owned agent from this conversation's child task with an explicit prompt.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "description": {
        "maxLength": 2000,
        "type": "string"
      },
      "instructions": {
        "maxLength": 16000,
        "minLength": 1,
        "type": "string"
      },
      "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "session_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "name",
      "instructions"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "turn the sub agent into a saved agent",
      "save this child task as an agent"
    ],
    "keywords": [
      "promote"
    ]
  }
}
