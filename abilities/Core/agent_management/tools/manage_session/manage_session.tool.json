{
  "name": "manage_session",
  "description": "Rename, pin, archive or unarchive a session in scope.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "enum": [
          "update",
          "archive",
          "unarchive"
        ],
        "type": "string"
      },
      "request": {
        "type": "object"
      },
      "session_id": {
        "format": "uuid",
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "action",
      "request"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "rename this session",
      "archive a chat",
      "pin a session"
    ],
    "keywords": [
      "rename",
      "archive",
      "pin"
    ]
  }
}
