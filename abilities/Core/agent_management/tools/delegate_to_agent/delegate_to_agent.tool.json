{
  "name": "delegate_to_agent",
  "description": "Hand off to an accessible saved agent in a new private conversation using a text summary.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "agent_id": {
        "maxLength": 128,
        "type": "string"
      },
      "text": {
        "maxLength": 65536,
        "minLength": 1,
        "type": "string"
      },
      "title": {
        "maxLength": 200,
        "type": "string"
      }
    },
    "required": [
      "text",
      "agent_id"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "hand this conversation to another agent",
      "pass the task to the research agent"
    ],
    "keywords": [
      "delegate",
      "hand off"
    ]
  }
}
