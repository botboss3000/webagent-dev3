{
  "name": "edit_agent_prompt",
  "description": "Edit one unlocked prompt slot for an agent the caller manages. Request: content, expected_revision, optional order_index, lock, merge_mode.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "agent_id": {
        "maxLength": 128,
        "type": "string"
      },
      "request": {
        "type": "object"
      },
      "slot": {
        "maxLength": 128,
        "type": "string"
      }
    },
    "required": [
      "agent_id",
      "slot",
      "request"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "change another agent's instructions",
      "edit the support agent's prompt"
    ],
    "keywords": [
      "agent prompt"
    ]
  }
}
