{
  "name": "update_agent",
  "description": "Update an agent the caller can manage. Request fields: revision plus name and/or description; owning Identity API validates other supported settings.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "agent_id": {
        "maxLength": 128,
        "type": "string"
      },
      "request": {
        "type": "object"
      }
    },
    "required": [
      "agent_id",
      "request"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "rename an agent",
      "change an agent's description"
    ],
    "keywords": [
      "update agent"
    ]
  }
}
