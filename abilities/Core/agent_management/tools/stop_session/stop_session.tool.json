{
  "name": "stop_session",
  "description": "Cancel a session's active runs and pending queued messages. Use it for a session in scope. It does not undo completed or uncertain external effects.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "session_id"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "stop the running session",
      "cancel the sub agent"
    ],
    "keywords": [
      "stop",
      "cancel session"
    ]
  }
}
