{
  "name": "set_app_view",
  "description": "Request a registered app destination in this caller's active conversation browser.",
  "effect": "write",
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "view": {
        "enum": [
          "chat",
          "files",
          "agents",
          "models",
          "abilities",
          "settings",
          "automations",
          "builds"
        ],
        "type": "string"
      }
    },
    "required": [
      "view"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "open the settings page for the user",
      "show the user the models page"
    ],
    "keywords": [
      "navigate",
      "open page"
    ]
  }
}
