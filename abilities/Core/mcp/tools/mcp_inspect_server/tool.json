{
  "name": "mcp_inspect_server",
  "description": "Inspect a public HTTPS MCP server before adding it; never accepts credentials",
  "effect": "read",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "auto",
    "visitor": "auto"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "endpoint": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "required": [
      "endpoint"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "inspect an MCP server before adding it"
    ],
    "keywords": [
      "mcp inspect"
    ]
  }
}
