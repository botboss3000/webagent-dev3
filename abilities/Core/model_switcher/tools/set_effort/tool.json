{
  "name": "set_effort",
  "description": "Set reasoning effort for subsequent calls in this run. Supported levels depend on the current model; list_models shows them.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "effort": {
        "enum": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "type": "string"
      }
    },
    "required": [
      "effort"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "think harder on this",
      "set reasoning effort to high"
    ],
    "keywords": [
      "effort",
      "reasoning"
    ]
  }
}
