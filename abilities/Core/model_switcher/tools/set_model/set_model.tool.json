{
  "name": "set_model",
  "description": "Select one existing model entry for the rest of this run. Applies at the next model boundary; does not edit agent assignments.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "entry_id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "entry_id"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "switch to another model",
      "use a different model for this run"
    ],
    "keywords": [
      "switch model"
    ]
  }
}
