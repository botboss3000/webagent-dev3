{
  "name": "sandbox_save",
  "description": "Save a sandbox folder's index.html as this agent's UI element for the user, kept across their conversations; asks for approval in Ask mode.",
  "effect": "write",
  "repeat_guard": {
    "risk": "low"
  },
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "deny"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "folder": {
        "type": "string",
        "maxLength": 200
      },
      "name": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,40}$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": {
        "type": "string",
        "maxLength": 300
      }
    },
    "required": [
      "folder",
      "name",
      "title"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "save this page as a reusable element",
      "save the element I built"
    ],
    "keywords": [
      "element",
      "save"
    ]
  }
}
