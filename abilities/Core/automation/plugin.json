      "tools/schedule_task/schedule_task.tool.json",
      "tools/remind_me/remind_me.tool.json",
      "tools/list_automations/list_automations.tool.json",
      "tools/update_automation/update_automation.tool.json",
      "tools/pause_automation/pause_automation.tool.json",
      "tools/resume_automation/resume_automation.tool.json",
      "tools/cancel_automation/cancel_automation.tool.json",
      "tools/run_automation_now/run_automation_now.tool.json",
      "tools/remember_automation_state/remember_automation_state.tool.json"
