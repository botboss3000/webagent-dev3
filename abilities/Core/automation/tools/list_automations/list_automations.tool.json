{
  "name": "list_automations",
  "description": "list automations through the optional Automation service. Changes use revision checks; external adapters are unavailable.",
  "effect": "read",
  "retention": {
    "output": "disposable"
  },
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "allow"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "list my automations",
      "which scheduled tasks exist"
    ],
    "keywords": [
      "automations",
      "schedules"
    ]
  }
}
