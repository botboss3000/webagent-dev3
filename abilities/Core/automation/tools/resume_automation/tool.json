{
  "name": "resume_automation",
  "description": "resume automation through the optional Automation service. Changes use revision checks; external adapters are unavailable.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "id",
      "expected_revision"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "resume a paused automation"
    ],
    "keywords": [
      "resume"
    ]
  }
}
