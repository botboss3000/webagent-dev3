{
  "name": "run_automation_now",
  "description": "run automation now through the optional Automation service. Changes use revision checks; external adapters are unavailable.",
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "id",
      "expected_revision",
      "request_id"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "run the automation now",
      "trigger the scheduled task immediately"
    ],
    "keywords": [
      "run now"
    ]
  }
}
