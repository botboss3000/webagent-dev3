{
  "name": "read_user_file",
  "description": "Read a bounded byte page of a private saved file as base64 and UTF-8 text when valid.",
  "effect": "read",
  "retention": {
    "output": "disposable"
  },
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "allow"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "limit": {
        "maximum": 65536,
        "minimum": 1,
        "type": "integer"
      },
      "name": {
        "maxLength": 255,
        "type": "string"
      },
      "offset": {
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "match": {
    "examples": [
      "read one of my saved files",
      "open my saved document"
    ],
    "keywords": [
      "read saved file"
    ]
  }
}
