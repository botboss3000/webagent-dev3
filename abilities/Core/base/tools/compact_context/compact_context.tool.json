{
  "name": "compact_context",
  "description": "Ask the user whether to summarize an earlier finished task now that the conversation has moved on.",
  "parameters": {
    "type": "object",
    "properties": {
      "new_task_quote": {
        "type": "string",
        "minLength": 12,
        "maxLength": 300
      },
      "earlier_task": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      },
      "focus": {
        "type": "string",
        "maxLength": 300
      }
    },
    "required": [
      "new_task_quote",
      "earlier_task"
    ],
    "additionalProperties": false
  },
  "core": true,
  "effect": "read",
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "allow"
  }
}
