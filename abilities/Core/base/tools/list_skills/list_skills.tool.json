{
  "name": "list_skills",
  "description": "List selectable skills of one ability; include_available also shows visible and already loaded ones. Tool skills load by tool name with load_skill.",
  "parameters": {
    "type": "object",
    "properties": {
      "ability_id": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9_]+$",
        "type": "string"
      },
      "include_available": {
        "type": "boolean"
      },
      "query": {
        "maxLength": 200,
        "type": "string"
      }
    },
    "required": [
      "ability_id"
    ],
    "additionalProperties": false
  },
  "core": true,
  "effect": "read",
  "retention": {
    "output": "disposable"
  },
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "allow"
  }
}
