{
  "name": "load_tool",
  "description": "Load permitted tools by exact name (up to 8 per call) for this conversation.",
  "parameters": {
    "type": "object",
    "properties": {
      "tool_name": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "tool_names": {
        "items": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 8,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "core": true,
  "effect": "read",
  "default_policy": {
    "operator": "allow",
    "member": "allow",
    "visitor": "allow"
  }
}
