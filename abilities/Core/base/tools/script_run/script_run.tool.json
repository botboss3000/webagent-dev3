{
  "name": "script_run",
  "description": "Run a session or saved script's steps in order as ordinary tool calls.",
  "parameters": {
    "type": "object",
    "properties": {
      "args": {
        "additionalProperties": {
          "maxLength": 2000,
          "type": "string"
        },
        "description": "Text for each declared param, up to 2000 characters each",
        "type": "object"
      },
      "name": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "type": "string"
      },
      "scope": {
        "enum": [
          "session",
          "saved"
        ],
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "effect": "read",
  "retention": {
    "output": "log",
    "tail_lines": 40
  },
  "default_policy": {
    "operator": "allow",
    "member": "require_approval",
    "visitor": "require_approval"
  }
}
