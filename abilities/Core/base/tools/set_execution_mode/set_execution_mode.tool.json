{
  "name": "set_execution_mode",
  "description": "Change this session to an agent execution mode (ask, plan, auto or custom).",
  "parameters": {
    "type": "object",
    "properties": {
      "mode": {
        "maxLength": 32,
        "type": "string"
      },
      "reason": {
        "maxLength": 500,
        "type": "string"
      },
      "plan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checklist"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "goal": {
            "type": "string",
            "maxLength": 1200
          },
          "criteria": {
            "type": "string",
            "maxLength": 1200
          },
          "notes": {
            "type": "string",
            "maxLength": 1200
          },
          "checklist": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 240
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "done",
                    "blocked"
                  ]
                },
                "verification": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "mode"
    ],
    "additionalProperties": false
  },
  "effect": "read",
  "default_policy": {
    "operator": "allow",
    "member": "require_approval",
    "visitor": "require_approval"
  }
}
