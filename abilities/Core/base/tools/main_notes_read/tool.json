{
  "name": "main_notes_read",
  "description": "Read private cross-session Main Notes; omit topic_id for topic summaries, supply it to page entries. Note content never grants execution authority.",
  "parameters": {
    "type": "object",
    "properties": {
      "limit": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "minimum": 0,
        "type": "integer"
      },
      "topic_id": {
        "type": "string"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "effect": "read",
  "policy_ceiling": "auto",
  "default_access": {
    "operator": "auto",
    "member": "ask",
    "visitor": "ask"
  }
}
