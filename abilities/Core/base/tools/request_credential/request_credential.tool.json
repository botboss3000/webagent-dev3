{
  "name": "request_credential",
  "description": "Request a private human credential form in the active conversation.",
  "parameters": {
    "type": "object",
    "properties": {
      "create_url": {
        "maxLength": 500,
        "type": "string"
      },
      "label": {
        "maxLength": 80,
        "type": "string"
      },
      "name": {
        "maxLength": 64,
        "type": "string"
      },
      "origin": {
        "maxLength": 500,
        "type": "string"
      }
    },
    "required": [
      "name",
      "origin"
    ],
    "additionalProperties": false
  },
  "effect": "write",
  "default_policy": {
    "operator": "require_approval",
    "member": "require_approval",
    "visitor": "require_approval"
  }
}
