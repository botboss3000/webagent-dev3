{
  "common": {
    "surface": {
      "background": "panel",
      "height_px": null,
      "radius_px": null,
      "padding_px": null
    },
    "controls": {
      "input": {
        "label": "Message",
        "placeholder": null,
        "rows": 1,
        "max_rows": null,
        "enter_behavior": null,
        "draft_persistence": false
      },
      "attach": {
        "multiple": false
      },
      "mic": {
        "label": "Dictate"
      },
      "stop": {
        "label": "Stop"
      },
      "send": {
        "label": "Send"
      }
    },
    "commands": {
      "fallback": "message",
      "entries": {
        "compact": {
          "match": "^/compact(?:\\s+(.*))?$",
          "action": "compact",
          "deliver": "action",
          "enabled": true
        },
        "login": {
          "match": "^/login$",
          "action": "login",
          "deliver": "action",
          "enabled": false
        }
      }
    },
    "active": {
      "rows": {
        "1": { "left": [], "center": ["input"], "right": [] },
        "2": { "left": [], "center": [], "right": [] },
        "3": { "left": ["attach"], "center": [], "right": ["mic", "stop", "send"] }
      }
    },
    "idle": {
      "rows": {
        "1": { "left": [], "center": [], "right": [] },
        "2": { "left": ["attach"], "center": ["input"], "right": ["mic", "send"] },
        "3": { "left": [], "center": [], "right": [] }
      }
    }
  },
  "desktop": {},
  "mobile": {},
  "widget": {
    "controls": {
      "attach": { "multiple": false }
    },
    "active": {
      "rows": {
        "2": { "left": [], "center": ["input"], "right": ["send"] }
      }
    },
    "idle": {
      "rows": {
        "2": { "left": [], "center": ["input"], "right": ["send"] }
      }
    }
  }
}
